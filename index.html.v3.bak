<!DOCTYPE html>
<html lang="zh-CN" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1">
<title>山东高考报名 · 倒计时与一键填写</title>
<meta name="description" content="山东省2027年高考报名：开闸倒计时、Web Push 提醒、官方入口直达、一键填写报名信息。">
<meta name="theme-color" content="#f2f2f7" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)">
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" href="icons/icon-192.png">
<link rel="apple-touch-icon" href="icons/icon-192.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<style>
/* ================= HIG tokens ================= */
:root[data-theme="light"]{
  --bg:#f2f2f7; --card:#ffffff;
  --label:#000; --label-2:rgba(60,60,67,.60); --label-3:rgba(60,60,67,.30);
  --sep:rgba(60,60,67,.18);
  --blue:#007aff; --green:#34c759; --red:#ff3b30; --orange:#ff9500;
  --tint-bg:rgba(0,122,255,.10);
  --chrome:rgba(255,255,255,.72); --chrome-line:rgba(255,255,255,.45);
  --scrim:rgba(0,0,0,.42);
  --fill:rgba(120,120,128,.12); --fill-2:rgba(120,120,128,.20);
  --shadow:0 1px 2px rgba(0,0,0,.05), 0 8px 24px rgba(0,0,0,.06);
  --sheet-shadow:0 -1px 0 rgba(0,0,0,.08), 0 -10px 40px rgba(0,0,0,.18);
}
:root[data-theme="dark"]{
  --bg:#000; --card:#1c1c1e;
  --label:#fff; --label-2:rgba(235,235,245,.60); --label-3:rgba(235,235,245,.30);
  --sep:rgba(84,84,88,.55);
  --blue:#0a84ff; --green:#30d158; --red:#ff453a; --orange:#ff9f0a;
  --tint-bg:rgba(10,132,255,.18);
  --chrome:rgba(30,30,32,.72); --chrome-line:rgba(255,255,255,.10);
  --scrim:rgba(0,0,0,.6);
  --fill:rgba(120,120,128,.24); --fill-2:rgba(120,120,128,.36);
  --shadow:0 1px 2px rgba(0,0,0,.4), 0 8px 24px rgba(0,0,0,.5);
  --sheet-shadow:0 -1px 0 rgba(255,255,255,.08), 0 -10px 40px rgba(0,0,0,.7);
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html{-webkit-text-size-adjust:100%}
body{
  font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","Segoe UI",
    "PingFang SC","Hiragino Sans GB","Microsoft YaHei",system-ui,sans-serif;
  background:var(--bg);color:var(--label);font-size:17px;line-height:1.42;letter-spacing:-.01em;
  -webkit-font-smoothing:antialiased;overscroll-behavior-y:none;
  transition:background .3s ease,color .3s ease;
}
.wrap{max-width:640px;margin:0 auto;padding:0 16px}
button{font-family:inherit}

/* ================= 下拉刷新 ================= */
.ptr{position:fixed;top:0;left:0;right:0;height:0;display:grid;place-items:center;pointer-events:none;z-index:5;overflow:hidden}
.ptr-in{width:34px;height:34px;border-radius:50%;background:var(--chrome);backdrop-filter:blur(20px) saturate(180%);border:1px solid var(--chrome-line);display:grid;place-items:center;will-change:transform,opacity}
.ptr-in svg{width:17px;height:17px;color:var(--label-2);will-change:transform}

/* ================= 导航 ================= */
.nav{position:sticky;top:0;z-index:40;background:var(--chrome);backdrop-filter:blur(20px) saturate(180%);-webkit-backdrop-filter:blur(20px) saturate(180%);border-bottom:.5px solid transparent;transition:border-color .25s,background .3s}
.nav.scrolled{border-bottom-color:var(--sep)}
.nav-in{display:flex;align-items:center;justify-content:space-between;height:52px;gap:12px}
.nav-title{font-size:17px;font-weight:600;letter-spacing:-.02em;opacity:0;transition:opacity .25s}
.nav.scrolled .nav-title{opacity:1}
.tgl{width:51px;height:31px;border-radius:16px;flex:none;position:relative;cursor:pointer;background:var(--fill-2);border:none;padding:0;transition:background .28s cubic-bezier(.4,0,.2,1)}
.tgl.on{background:var(--green)}
.tgl .knob{position:absolute;top:2px;left:2px;width:27px;height:27px;border-radius:50%;background:#fff;box-shadow:0 2px 5px rgba(0,0,0,.22),0 0 1px rgba(0,0,0,.16);will-change:transform}
.tgl .knob i{position:absolute;inset:0;display:grid;place-items:center;color:var(--label-3)}
.tgl .knob svg{width:14px;height:14px}
.tgl:active .knob{transform:scale(.94)}

/* ================= 标题 ================= */
.large-title{padding:14px 0 16px}
.large-title h1{font-size:30px;line-height:36px;font-weight:700;letter-spacing:-.025em}
.large-title p{font-size:15px;line-height:20px;color:var(--label-2);margin-top:4px}

/* ================= Hero ================= */
.hero{
  background:linear-gradient(150deg,#0a5cc4,#0a84ff 55%,#3aa8f0);color:#fff;
  border-radius:18px;padding:20px 16px;margin-bottom:18px;position:relative;overflow:hidden;
  box-shadow:0 10px 30px rgba(10,132,255,.30);
  animation:heroIn .6s cubic-bezier(.32,.72,0,1) both .05s;
}
@keyframes heroIn{from{opacity:0;transform:translateY(14px) scale(.985)}to{opacity:1;transform:none}}
:root[data-theme="dark"] .hero{background:linear-gradient(150deg,#083f80,#0a5cc4 55%,#0a84ff);box-shadow:0 10px 30px rgba(0,0,0,.5)}
.hero::after{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(560px 200px at 90% -12%,rgba(255,255,255,.20),transparent 70%)}
.hero>*{position:relative;z-index:1}
.hero-tag{display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,.20);border:1px solid rgba(255,255,255,.28);padding:4px 11px;border-radius:999px;font-size:13px;font-weight:600;margin-bottom:12px}
.hero-tag .pulse{width:7px;height:7px;border-radius:50%;background:#fff;box-shadow:0 0 0 4px rgba(255,255,255,.24);animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.28}}

/* ============ 里程表滚动数字（弹簧逐位滚动） ============ */
.cd{display:flex;justify-content:center;align-items:flex-start;gap:6px}
.grp{display:flex;flex-direction:column;align-items:center}
.digits{display:flex}
.odo{display:block;height:1em;overflow:hidden;font-size:50px;line-height:1;font-weight:700;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
.odo .col{display:block;will-change:transform}
.odo .col i{display:block;height:1em;font-style:normal;text-align:center}
.sep{font-size:34px;line-height:50px;color:rgba(255,255,255,.42);font-weight:600;flex:none;padding:0 1px}
.grp .l{font-size:12px;color:rgba(255,255,255,.80);margin-top:4px;font-weight:500;letter-spacing:.1em}

.hero-meta{margin-top:14px;padding:9px 12px;border-radius:10px;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.20);font-size:14px;line-height:20px;color:rgba(255,255,255,.94);text-align:center}
.hero-meta b{color:#fff;font-weight:600}
.hero-meta .live{display:inline-block;width:6px;height:6px;border-radius:50%;margin-right:6px;vertical-align:1px}
.hero-meta .live.on{background:#4ade80;box-shadow:0 0 6px #4ade80}
.hero-meta .live.off{background:rgba(255,255,255,.55)}

.btns{display:flex;gap:8px;margin-top:14px}
.btn{
  -webkit-appearance:none;appearance:none;font-size:15px;font-weight:600;letter-spacing:-.01em;
  min-height:44px;padding:0 15px;border-radius:12px;border:none;cursor:pointer;
  background:rgba(255,255,255,.22);color:#fff;
  display:inline-flex;align-items:center;justify-content:center;gap:7px;flex:1;
  backdrop-filter:blur(6px);transition:transform .12s cubic-bezier(.2,0,.2,1),background .18s,opacity .18s;will-change:transform;
}
.btn svg{width:16px;height:16px;flex:none}
.btn:active{transform:scale(.965)}
.btn.solid{background:#fff;color:#0a84ff;box-shadow:0 2px 8px rgba(0,0,0,.14)}
.btn.ghost{flex:0 0 auto;width:44px;padding:0}
.btn.on{background:rgba(52,199,89,.92);color:#fff}
.btn:disabled{opacity:.55;cursor:default}
.btn.spin svg{animation:spin 1s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.pstat{display:flex;align-items:center;gap:7px;margin-top:13px;font-size:14px;color:rgba(255,255,255,.92)}
.pill{display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:600;padding:2px 9px;border-radius:999px;background:rgba(255,255,255,.22);flex:none}
.pill.s{background:rgba(52,199,89,.95);color:#fff}
.pill.d{background:rgba(255,59,48,.95);color:#fff}
.pill.w{background:rgba(255,149,0,.95);color:#fff}

/* ================= 分段控件 ================= */
.seg{display:flex;position:relative;background:var(--fill);border-radius:10px;padding:2px;margin-bottom:20px}
.seg button{-webkit-appearance:none;appearance:none;border:none;background:none;cursor:pointer;flex:1;min-height:36px;font-size:15px;font-weight:600;color:var(--label-2);letter-spacing:-.01em;position:relative;z-index:2;transition:color .18s;border-radius:8px}
.seg button.on{color:var(--label)}
.seg .thumb{position:absolute;top:2px;left:2px;height:calc(100% - 4px);border-radius:8px;background:var(--card);box-shadow:0 1px 3px rgba(0,0,0,.10),0 0 1px rgba(0,0,0,.10);will-change:transform;z-index:1}
:root[data-theme="dark"] .seg .thumb{background:#636366;box-shadow:none}
.view{display:none}
.view.on{display:block;animation:vin .34s cubic-bezier(.32,.72,0,1) both}
@keyframes vin{from{opacity:0;transform:translateY(8px) scale(.995)}to{opacity:1;transform:none}}
.rise{opacity:0;transform:translateY(14px) scale(.985);will-change:transform,opacity}

/* ================= 卡片 ================= */
.group{background:var(--card);border-radius:14px;margin-bottom:20px;box-shadow:var(--shadow);overflow:hidden}
.group-hd{font-size:13px;line-height:18px;color:var(--label-2);padding:14px 16px 7px;display:flex;align-items:center;gap:7px}
.group-hd svg{width:14px;height:14px;opacity:.75;flex:none}
.group-hd span.rt{margin-left:auto}
.row{display:flex;align-items:center;gap:12px;padding:11px 16px;min-height:44px;border-top:.5px solid var(--sep)}
.row:first-of-type{border-top:none}
.row.col{flex-direction:column;align-items:stretch;gap:6px}
.row .lb{font-size:16px;letter-spacing:-.01em;min-width:0}
.row .lb.big{font-size:17px;font-weight:600}
.row .vl{margin-left:auto;font-size:15px;color:var(--label-2);text-align:right;font-variant-numeric:tabular-nums;flex:none}
.row .vl.mono{font-family:ui-monospace,"SF Mono",Consolas,monospace;font-size:13px}
.row .vl.ok{color:var(--green);font-weight:600}
.row .vl.bad{color:var(--red);font-weight:600}
.row .sub{font-size:14px;line-height:20px;color:var(--label-2)}
.note{margin:0 16px 16px;padding:12px 14px;border-radius:10px;background:var(--fill);font-size:14px;line-height:20px}
.note.warn{background:rgba(255,149,0,.14)}
.note b{font-weight:600}
.btn2{
  -webkit-appearance:none;appearance:none;cursor:pointer;font-size:15px;font-weight:600;
  min-height:44px;padding:0 16px;border-radius:12px;border:none;background:var(--tint-bg);color:var(--blue);
  display:inline-flex;align-items:center;gap:7px;margin:12px 16px 16px;
  transition:transform .12s cubic-bezier(.2,0,.2,1);
}
.btn2:active{transform:scale(.965)}
.btn2 svg{width:16px;height:16px}

/* ================= 表单 ================= */
.fld{padding:9px 16px;min-height:44px;border-top:.5px solid var(--sep)}
.fld:first-of-type{border-top:none}
.fld label{display:block;font-size:13px;color:var(--label-2);margin-bottom:4px}
.fld input,.fld select,.fld textarea{
  width:100%;border:none;outline:none;background:transparent;color:var(--label);
  font-family:inherit;font-size:17px;letter-spacing:-.01em;padding:0;
}
.fld textarea{resize:none;min-height:44px}
.fld input::placeholder,.fld textarea::placeholder{color:var(--label-3)}
.fld input[type=file]{font-size:13px;color:var(--label-2)}
.fld .hint{font-size:12px;color:var(--label-3);margin-top:3px}
.fld .hint.ok{color:var(--green)}
.photoRow{display:flex;gap:12px;align-items:center}
.photoRow img{width:64px;height:64px;border-radius:10px;object-fit:cover;border:.5px solid var(--sep);display:none}
.photoRow img.show{display:block}

/* ================= 磁贴 ================= */
.tiles{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.tile{display:flex;flex-direction:column;gap:9px;text-decoration:none;color:var(--label);background:var(--card);border-radius:14px;padding:14px;box-shadow:var(--shadow);transition:transform .16s cubic-bezier(.2,0,.2,1),box-shadow .2s,background .3s;will-change:transform}
.tile:active{transform:scale(.972)}
.tile:hover{box-shadow:0 2px 4px rgba(0,0,0,.06),0 12px 28px rgba(0,0,0,.10)}
.tile .ico{width:40px;height:40px;border-radius:11px;display:grid;place-items:center;background:var(--tint-bg);color:var(--blue)}
.tile .ico svg{width:20px;height:20px}
.tile .t{font-size:15px;line-height:20px;font-weight:600;letter-spacing:-.015em;display:flex;align-items:center;gap:4px}
.tile .t svg{width:12px;height:12px;color:var(--label-3);flex:none}
.tile .d{font-size:12px;line-height:16px;color:var(--label-2);word-break:break-all}
.tile.pri{background:linear-gradient(135deg,#0a5cc4,#0a84ff);color:#fff;box-shadow:0 6px 20px rgba(10,132,255,.30)}
.tile.pri .ico{background:rgba(255,255,255,.22);color:#fff}
.tile.pri .d{color:rgba(255,255,255,.82)}
.tile.pri .t svg{color:rgba(255,255,255,.72)}
.tile.wide{grid-column:1/-1;flex-direction:row;align-items:center;gap:13px}
.tile.wide .tx{flex:1;min-width:0}

/* ================= 清单 / 时间轴 ================= */
.chk{list-style:none}
.chk li{display:flex;gap:12px;align-items:flex-start;padding:11px 16px;min-height:44px;border-top:.5px solid var(--sep);cursor:pointer;transition:background .12s}
.chk li:first-child{border-top:none}
.chk li:active{background:var(--fill)}
.chk .box{width:22px;height:22px;border-radius:50%;flex:none;margin-top:1px;border:1.5px solid var(--label-3);display:grid;place-items:center;transition:background .2s,border-color .2s;will-change:transform}
.chk .box svg{width:13px;height:13px;color:#fff;opacity:0;transition:opacity .16s}
.chk li.on .box{background:var(--green);border-color:var(--green)}
.chk li.on .box svg{opacity:1}
.chk .tx{font-size:17px;letter-spacing:-.01em;transition:color .2s}
.chk li.on .tx{color:var(--label-3)}
.chk .sub{font-size:13px;line-height:18px;color:var(--label-2);margin-top:2px}
.prog-wrap{padding:14px 16px 16px}
.prog{height:6px;border-radius:3px;background:var(--fill);overflow:hidden}
.prog i{display:block;height:100%;background:var(--green);width:0;border-radius:3px;will-change:width}
.prog-tx{font-size:13px;line-height:18px;color:var(--label-2);margin-top:8px;text-align:right;font-variant-numeric:tabular-nums}
.tl{list-style:none;padding:0 16px}
.tl li{position:relative;padding:0 0 20px 26px}
.tl li:last-child{padding-bottom:14px}
.tl li::before{content:"";position:absolute;left:4px;top:6px;width:9px;height:9px;border-radius:50%;background:var(--card);border:2px solid var(--label-3);z-index:1;transition:background .3s,border-color .3s,box-shadow .3s}
.tl li:not(:last-child)::after{content:"";position:absolute;left:8px;top:17px;bottom:-2px;width:1.5px;background:var(--sep)}
.tl li.now::before{background:var(--blue);border-color:var(--blue);box-shadow:0 0 0 4px var(--tint-bg)}
.tl li.past::before{background:var(--label-3);border-color:var(--label-3)}
.tl .d{font-size:13px;line-height:18px;color:var(--label-2);font-variant-numeric:tabular-nums}
.tl .t{font-size:15px;line-height:20px;font-weight:600;letter-spacing:-.015em;margin-top:1px}
.tl li.now .t{color:var(--blue)}
.tl .s{font-size:13px;line-height:18px;color:var(--label-2);margin-top:2px}

/* ================= Sheet ================= */
.scrim{position:fixed;inset:0;background:var(--scrim);z-index:60;opacity:0;pointer-events:none;will-change:opacity}
.sheet{position:fixed;left:0;right:0;bottom:0;z-index:61;max-width:640px;margin:0 auto;background:var(--card);border-radius:14px 14px 0 0;box-shadow:var(--sheet-shadow);transform:translateY(110%);will-change:transform;display:flex;flex-direction:column;max-height:88vh}
.grabber{padding:10px 0 4px;display:grid;place-items:center;flex:none;cursor:grab;touch-action:none}
.grabber i{width:36px;height:5px;border-radius:3px;background:var(--label-3);display:block}
.sheet-hd{padding:4px 20px 12px;font-size:22px;line-height:28px;font-weight:700;letter-spacing:-.022em;border-bottom:.5px solid var(--sep);flex:none}
.sheet-bd{overflow-y:auto;-webkit-overflow-scrolling:touch;padding:4px 0 40px;flex:1;overscroll-behavior:contain}
.sheet-bd img{display:block;width:100%;height:auto;border-top:.5px solid var(--sep);border-bottom:.5px solid var(--sep)}
.sheet-bd figcaption{font-size:13px;line-height:18px;color:var(--label-2);padding:10px 20px}
.sheet-bd figcaption b{display:block;color:var(--label);font-size:14px;margin-bottom:2px}

/* ================= Toast ================= */
.toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom));z-index:80;transform:translate(-50%,20px);opacity:0;pointer-events:none;background:var(--chrome);backdrop-filter:blur(20px) saturate(180%);border:1px solid var(--chrome-line);color:var(--label);font-size:14px;font-weight:500;padding:11px 18px;border-radius:999px;box-shadow:0 6px 22px rgba(0,0,0,.20);will-change:transform,opacity;max-width:calc(100vw - 40px);text-align:center}

/* ================= 全屏提醒模式 ================= */
.fsm{
  position:fixed;inset:0;z-index:100;display:none;flex-direction:column;align-items:center;justify-content:center;
  background:linear-gradient(160deg,#071a33,#0a3c78 55%,#0a5cc4);color:#fff;
  text-align:center;padding:24px;
}
.fsm.on{display:flex;animation:vin .4s cubic-bezier(.32,.72,0,1) both}
.fsm .big{font-size:17px;font-weight:600;letter-spacing:.2em;color:rgba(255,255,255,.65)}
.fsm .count{font-size:clamp(56px,18vw,140px);font-weight:700;letter-spacing:-.03em;line-height:1.05;font-variant-numeric:tabular-nums;margin:12px 0}
.fsm .count small{font-size:.28em;font-weight:600;color:rgba(255,255,255,.7);margin-left:.15em}
.fsm .when{font-size:17px;color:rgba(255,255,255,.85)}
.fsm .when b{color:#fff}
.fsm.breathing{animation:breathe 4s ease-in-out infinite}
@keyframes breathe{0%,100%{filter:brightness(1)}50%{filter:brightness(1.25)}}
.fsm.opened{background:linear-gradient(160deg,#053a1c,#0c7a3d 55%,#34c759);animation:none}
.fsm.opened .count{animation:pop .5s cubic-bezier(.34,1.56,.64,1) both}
@keyframes pop{from{transform:scale(.6);opacity:0}to{transform:scale(1);opacity:1}}
.fsm .fsbtns{display:flex;gap:10px;margin-top:36px}
.fsm .fsb{-webkit-appearance:none;appearance:none;border:1px solid rgba(255,255,255,.35);background:rgba(255,255,255,.14);color:#fff;font-size:15px;font-weight:600;min-height:44px;padding:0 20px;border-radius:12px;cursor:pointer;backdrop-filter:blur(6px);text-decoration:none;display:inline-flex;align-items:center}
.fsm .fsb:active{transform:scale(.96)}
.fsm .tip{position:absolute;bottom:calc(18px + env(safe-area-inset-bottom));font-size:12px;color:rgba(255,255,255,.5);padding:0 20px}

footer{padding:8px 16px calc(40px + env(safe-area-inset-bottom));color:var(--label-2);font-size:13px;line-height:18px;text-align:center}
footer a{color:var(--blue);text-decoration:none}

@media (prefers-reduced-motion: reduce){
  *{animation-duration:.01ms !important;animation-iteration-count:1 !important}
  .view{animation:none}.hero{animation:none}.fsm{animation:none !important}
  .rise{opacity:1 !important;transform:none !important}
  .btn:active,.tile:active,.btn2:active,.fsm .fsb:active{transform:none}
}
@media (prefers-reduced-transparency: reduce){
  .nav{background:var(--card);backdrop-filter:none}
  .ptr-in,.toast{background:var(--card);backdrop-filter:none}
}
@media (prefers-contrast: more){
  :root[data-theme="light"]{--label-2:#3c3c43;--sep:rgba(0,0,0,.35)}
  :root[data-theme="dark"]{--label-2:#ebebf5;--sep:rgba(255,255,255,.45)}
  .nav{background:var(--card);backdrop-filter:none}
}
@media (max-width:420px){
  .odo{font-size:42px}
  .sep{font-size:28px;line-height:42px}
  .tiles{grid-template-columns:1fr}
}
</style>
</head>
<body>

<div class="ptr" id="ptr"><div class="ptr-in" id="ptrIn">
  <svg id="ptrIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4"/><path d="M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4"/></svg>
</div></div>

<div class="nav" id="nav">
  <div class="wrap nav-in">
    <div class="nav-title">山东高考报名</div>
    <button class="tgl" id="tgl" onclick="toggleTheme()" aria-label="切换深色模式" role="switch">
      <div class="knob" id="knob"><i>
        <svg class="i-m" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454z"/></svg>
        <svg class="i-s" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><circle cx="12" cy="12" r="4"/><path d="M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.5 -15.5l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7"/></svg>
      </i></div>
    </button>
  </div>
</div>

<main class="wrap">
  <div class="large-title">
    <h1>山东高考报名</h1>
    <p>2027 年春季 / 夏季高考 · 倒计时 · 一键填写</p>
  </div>

  <!-- ============ Hero ============ -->
  <section class="hero">
    <div class="hero-tag"><span class="pulse"></span><span id="tagText">报名通道未开放</span></div>
    <div class="cd" id="cd"></div>
    <div class="hero-meta" id="heroMeta">加载中…</div>
    <div class="btns">
      <button class="btn solid" id="probeBtn" onclick="probe()">
        <svg id="probeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4"/><path d="M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4"/></svg>
        <span id="probeTx">立即探测</span>
      </button>
      <button class="btn ghost" id="notifyBtn" onclick="subscribePush()" title="开闸推送提醒（锁屏可收）">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 5a2 2 0 1 1 4 0a7 7 0 0 1 4 6v3a4 4 0 0 0 2 3h-16a4 4 0 0 0 2 -3v-3a7 7 0 0 1 4 -6"/><path d="M9 17v1a3 3 0 0 0 6 0v-1"/></svg>
      </button>
      <button class="btn ghost" onclick="openFS()" title="全屏倒计时提醒">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0 -2 2v3"/><path d="M16 3h3a2 2 0 0 1 2 2v3"/><path d="M8 21H5a2 2 0 0 1 -2 -2v-3"/><path d="M16 21h3a2 2 0 0 0 2 -2v-3"/></svg>
      </button>
      <button class="btn ghost" onclick="copyUrl()" title="复制报名网址">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8v-2a2 2 0 0 0 -2 -2h-8a2 2 0 0 0 -2 2v8a2 2 0 0 0 2 2h2"/></svg>
      </button>
    </div>
    <div class="pstat" id="pstat"><span class="pill">待探测</span><span>尚未探测</span></div>
  </section>

  <div class="seg" id="seg">
    <div class="thumb" id="thumb"></div>
    <button class="on" data-v="status" onclick="setView('status',this)">状态</button>
    <button data-v="info" onclick="setView('info',this)">信息</button>
    <button data-v="links" onclick="setView('links',this)">入口</button>
    <button data-v="prep" onclick="setView('prep',this)">准备</button>
  </div>

  <!-- ============ 状态 ============ -->
  <section class="view on" id="v-status">
    <div class="group rise">
      <div class="group-hd"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>当前时段</div>
      <div class="row"><div class="lb big" id="winState">…</div></div>
      <div class="row"><div class="sub" id="winDetail">…</div></div>
    </div>
    <div class="group rise">
      <div class="group-hd"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4"/><path d="M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4"/></svg>探测记录<span class="rt">本机保存</span></div>
      <div id="histList"></div>
    </div>
    <div class="group rise">
      <div class="group-hd"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.29 3.86l-8.486 14.686a1.5 1.5 0 0 0 1.29 2.25h16.914a1.5 1.5 0 0 0 1.29 -2.25l-8.485 -14.686a1.5 1.5 0 0 0 -2.582 0z"/></svg>为什么现在打不开</div>
      <div class="row"><div class="lb big">① 时间未到</div></div>
      <div class="row"><div class="sub">官方通知：填报期 <b style="color:var(--label)">2026年10月24日—30日，每天仅 9:00–18:00</b>。窗口外系统闸门关闭。</div></div>
      <div class="row"><div class="lb big">② 系统面向电脑</div></div>
      <div class="row"><div class="sub">要传照片、填大量信息、在线缴费，官方说明按桌面浏览器编写 —— 手机打不开不是手机坏了。</div></div>
      <div class="row"><div class="lb">已排除</div><div class="vl ok">DNS / 防火墙 / 证书 / 本地网络</div></div>
    </div>
    <div class="group rise">
      <div class="group-hd"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8v-2a2 2 0 0 1 2 -2h2"/><path d="M4 16v2a2 2 0 0 0 2 2h2"/><path d="M16 4h2a2 2 0 0 1 2 2v2"/><path d="M16 20h2a2 2 0 0 0 2 -2v-2"/><circle cx="12" cy="12" r="3"/></svg>实测诊断数据<span class="rt">2026-10-23 抓取</span></div>
      <div class="row"><div class="lb">DNS 解析</div><div class="vl mono">112.53.87.10 / CERNET2</div></div>
      <div class="row"><div class="lb">TCP 443</div><div class="vl ok">连接成功</div></div>
      <div class="row"><div class="lb">TLS 握手</div><div class="vl ok">TLSv1.2 · *.sdzk.cn</div></div>
      <div class="row"><div class="lb">HTTP GET /</div><div class="vl bad">25 秒 0 字节</div></div>
      <div class="row"><div class="lb">80 端口</div><div class="vl ok">301 → https</div></div>
      <div class="row"><div class="lb">官网 www.sdzk.cn</div><div class="vl ok">HTTP 200</div></div>
      <button class="btn2" onclick="openSheet()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8v-2a2 2 0 0 1 2 -2h2"/><path d="M4 16v2a2 2 0 0 0 2 2h2"/><path d="M16 4h2a2 2 0 0 1 2 2v2"/><path d="M16 20h2a2 2 0 0 0 2 -2v-2"/><circle cx="12" cy="12" r="3"/></svg>查看截图证据</button>
    </div>
    <div class="group rise">
      <div class="group-hd"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z"/><path d="M16 3v4"/><path d="M8 3v4"/><path d="M4 11h16"/></svg>完整时间轴</div>
      <ul class="tl">
        <li id="tl1"><div class="d">2026-10-24 — 10-30</div><div class="t">填报信息 + 缴纳报名费</div><div class="s">每天 9:00–18:00 ｜ 缴完报名费才算报名成功</div></li>
        <li id="tl2"><div class="d">2026-10-31 — 11-12</div><div class="t">资格审核</div><div class="s">不通过须携证明材料到现场</div></li>
        <li id="tl3"><div class="d">2026-11-13 — 11-15</div><div class="t">缴纳考试费</div><div class="s">每天 9:00–18:00</div></li>
        <li id="tl4"><div class="d">2027 年 4 月</div><div class="t">春考知识 / 夏考统考费</div><div class="s">具体时间另行通知</div></li>
      </ul>
    </div>
  </section>

  <!-- ============ 信息（一键填写数据卡） ============ -->
  <section class="view" id="v-info">
    <div class="group rise">
      <div class="group-hd"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z"/></svg>我的报名信息<span class="rt">只存本机，不上传</span></div>
      <div class="fld"><label>姓名 *</label><input id="f-name" placeholder="与身份证一致"></div>
      <div class="fld"><label>身份证号 *</label><input id="f-idcard" maxlength="18" placeholder="18 位"><div class="hint" id="idcHint">填写后自动推导出生日期与性别</div></div>
      <div class="fld"><label>手机号 *</label><input id="f-phone" type="tel" maxlength="11" placeholder="本人实名手机号"></div>
      <div class="fld"><label>民族</label><select id="f-nation">
        <option value="">请选择</option><option>汉族</option><option>回族</option><option>满族</option><option>蒙古族</option><option>藏族</option><option>维吾尔族</option><option>苗族</option><option>彝族</option><option>壮族</option><option>布依族</option><option>朝鲜族</option><option>侗族</option><option>瑶族</option><option>白族</option><option>土家族</option><option>哈尼族</option><option>哈萨克族</option><option>傣族</option><option>黎族</option><option>其他</option>
      </select></div>
      <div class="fld"><label>政治面貌</label><select id="f-politics">
        <option value="">请选择</option><option>中共党员</option><option>中共预备党员</option><option>共青团员</option><option>群众</option><option>民主党派成员</option>
      </select></div>
      <div class="fld"><label>报考类型</label><select id="f-examType">
        <option value="">请选择</option><option>春季高考</option><option>夏季高考</option><option>春季+夏季兼报</option>
      </select></div>
      <div class="fld"><label>考生类别</label><select id="f-category">
        <option value="">请选择</option><option>城市应届</option><option>农村应届</option><option>城市往届</option><option>农村往届</option>
      </select></div>
      <div class="fld"><label>毕业 / 就读学校</label><input id="f-school" placeholder="学校全称"></div>
      <div class="fld"><label>学籍号 / 考籍号</label><input id="f-studentNo" placeholder="G 或 L 开头"></div>
      <div class="fld"><label>QQ 号</label><input id="f-qq" inputmode="numeric" placeholder="选填"></div>
      <div class="fld"><label>电子邮箱</label><input id="f-email" type="email" placeholder="选填"></div>
      <div class="fld"><label>户籍地址</label><textarea id="f-address" rows="2" placeholder="户口簿上的地址"></textarea></div>
      <div class="fld"><label>证件照片（报名上传用）</label>
        <div class="photoRow">
          <img id="photoPrev" alt="照片预览">
          <input type="file" id="f-photo" accept="image/*" style="flex:1">
        </div>
        <div class="hint" id="photoHint">选择后自动压缩到 800px 内（JPG），存本机</div>
      </div>
      <button class="btn2 green" onclick="copyInfo()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8v-2a2 2 0 0 0 -2 -2h-8a2 2 0 0 0 -2 2v8a2 2 0 0 0 2 2h2"/></svg>复制报名数据（给一键填写用）</button>
    </div>

    <div class="group rise">
      <div class="group-hd"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l9 4.9v10.2L12 22l-9-4.9V6.9z"/><path d="M12 22V12"/><path d="M12 12L3 6.9"/><path d="M12 12l9-5.1"/></svg>一键填写 · 三步装好</div>
      <div class="row"><div class="lb big">① 装脚本管理器</div></div>
      <div class="row"><div class="sub">电脑 Chrome/Edge 装 <a href="https://chromewebstore.google.com/detail/violentmonkey/jinjaccalgkegednnccohejagnlnfdag" target="_blank" rel="noopener" style="color:var(--blue)">Violentmonkey</a>（开源）或 Tampermonkey；安卓用 Firefox + Violentmonkey。</div></div>
      <div class="row"><div class="lb big">② 安装填写脚本</div></div>
      <div class="row"><div class="sub">点下面按钮下载脚本 → 脚本管理器自动弹出安装页 → 确认安装。</div></div>
      <a class="btn2" href="山东高考报名-一键填写.user.js" download><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="M8 11l4 4l4 -4"/><path d="M4 19h16"/></svg>下载一键填写脚本</a>
      <div class="row"><div class="lb big">③ 明早开闸后</div></div>
      <div class="row"><div class="sub">打开 wsbm.sdzk.cn → 点右侧悬浮球「导入面板数据」→「一键填写表单」「一键上传照片」→ 人工核对 → 提交缴费。</div></div>
      <div class="note" style="margin:2px 16px 16px"><b>诚实说明：</b>报名系统此刻未开闸，字段名无法提前 100% 确认。脚本按常见命名做智能匹配（姓名/身份证/手机/学校/民族等 15 类），绿框标注已填项并提示未匹配项；万一有漏的，手动补两下即可。开闸首日若匹配不准，把实际字段名反馈我，立刻更新脚本。</div>
    </div>
  </section>

  <!-- ============ 入口 ============ -->
  <section class="view" id="v-links">
    <div class="tiles">
      <a class="tile pri rise" href="https://wsbm.sdzk.cn" target="_blank" rel="noopener">
        <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z"/><path d="M9 9h1"/><path d="M9 13h6"/><path d="M9 17h6"/></svg></div>
        <div><div class="t">网上报名系统 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6"/><path d="M10 14l11 -11"/><path d="M15 4h5v5"/></svg></div>
        <div class="d" style="margin-top:5px">https://wsbm.sdzk.cn</div></div>
      </a>
      <a class="tile rise" href="https://www.sdzk.cn/" target="_blank" rel="noopener">
        <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l-2 0l9 -9l9 9l-2 0"/><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7"/><path d="M10 12h4v7h-4z"/></svg></div>
        <div><div class="t">省招考院官网 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6"/><path d="M10 14l11 -11"/><path d="M15 4h5v5"/></svg></div>
        <div class="d" style="margin-top:5px">www.sdzk.cn</div></div>
      </a>
      <a class="tile wide rise" href="https://www.sdzk.cn/NewsInfo.aspx?NewsID=7398" target="_blank" rel="noopener">
        <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z"/></svg></div>
        <div class="tx"><div class="t">网上报名操作说明 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6"/><path d="M10 14l11 -11"/><path d="M15 4h5v5"/></svg></div>
        <div class="d">NewsID=7398 ｜ 2026-10-20 发布</div></div>
      </a>
      <a class="tile wide rise" href="https://www.sdzk.cn/NewsInfo.aspx?NewsID=7394" target="_blank" rel="noopener">
        <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z"/><path d="M9 9h1"/><path d="M9 13h6"/><path d="M9 17h6"/></svg></div>
        <div class="tx"><div class="t">2027 年高考报名通知 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6"/><path d="M10 14l11 -11"/><path d="M15 4h5v5"/></svg></div>
        <div class="d">含全部时间节点与报名条件（官方原文）</div></div>
      </a>
      <a class="tile rise" href="https://www.sdzk.cn/NewsInfo.aspx?NewsID=7395" target="_blank" rel="noopener">
        <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 9l-10 -4l-10 4l10 4l10 -4v6"/><path d="M6 10.6v5.4a3 3 0 0 0 3 3h6a3 3 0 0 0 3 -3v-5.4"/></svg></div>
        <div><div class="t">春季高考 35 问 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6"/><path d="M10 14l11 -11"/><path d="M15 4h5v5"/></svg></div>
        <div class="d" style="margin-top:5px">中职 / 3+4 转段必读</div></div>
      </a>
      <a class="tile rise" href="https://www.sdzk.cn/NewsInfo.aspx?NewsID=7396" target="_blank" rel="noopener">
        <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.5 -15.5l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7"/></svg></div>
        <div><div class="t">夏季高考 35 问 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6"/><path d="M10 14l11 -11"/><path d="M15 4h5v5"/></svg></div>
        <div class="d" style="margin-top:5px">含体育类 / 艺术类</div></div>
      </a>
    </div>
    <div class="note" style="margin:16px 0 0">全部为 <b>sdzk.cn</b> 官方域名，点击即直达。</div>
  </section>

  <!-- ============ 准备 ============ -->
  <section class="view" id="v-prep">
    <div class="group rise">
      <div class="group-hd"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5h-2a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-12a2 2 0 0 0 -2 -2h-2"/><rect x="9" y="3" width="6" height="4" rx="2"/><path d="M9 12l2 2l4 -4"/></svg>开闸前备料清单 · 点击勾选</div>
      <ul class="chk" id="chk">
        <li data-k="1"><div class="box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5l10 -10"/></svg></div><div><div class="tx">居民身份证</div><div class="sub">在有效期内，信息须与户籍一致</div></div></li>
        <li data-k="2"><div class="box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5l10 -10"/></svg></div><div><div class="tx">户口簿（户主页 + 本人页）</div><div class="sub">外省迁入须满两年（截至 2026-10-24）</div></div></li>
        <li data-k="3"><div class="box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5l10 -10"/></svg></div><div><div class="tx">学籍信息 / 毕业证书</div><div class="sub">应届生备学籍号，往届生备毕业证</div></div></li>
        <li data-k="4"><div class="box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5l10 -10"/></svg></div><div><div class="tx">本人实名手机号</div><div class="sub">注册与接收验证码，别用家长号码</div></div></li>
        <li data-k="5"><div class="box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5l10 -10"/></svg></div><div><div class="tx">电子证件照</div><div class="sub">已可在「信息」页存好，一键上传</div></div></li>
        <li data-k="6"><div class="box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5l10 -10"/></svg></div><div><div class="tx">可用的支付方式</div><div class="sub">报名费在线缴，确保卡 / 微信 / 支付宝可用</div></div></li>
        <li data-k="7"><div class="box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5l10 -10"/></svg></div><div><div class="tx">一台能用的电脑 + 脚本就绪</div><div class="sub">装好 Violentmonkey 与一键填写脚本</div></div></li>
      </ul>
      <div class="prog-wrap"><div class="prog"><i id="progBar"></i></div><div class="prog-tx" id="progTx">0 / 7 已备齐</div></div>
    </div>
    <div class="group rise">
      <div class="group-hd"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.29 3.86l-8.486 14.686a1.5 1.5 0 0 0 1.29 2.25h16.914a1.5 1.5 0 0 0 1.29 -2.25l-8.485 -14.686a1.5 1.5 0 0 0 -2.582 0z"/></svg>三个最容易踩的坑</div>
      <div class="note warn" style="margin:14px 16px">
        <b>① 只在 9:00–18:00 开放</b>，早晚访问必然不通。<br>
        <b>② 缴完报名费才算报名成功</b>，只填信息不缴费视为未报名。<br>
        <b>③ 春季与夏季同时报考须分别缴费。</b><br>
        拟参加高职（专科）单独考试招生的，需在 11月13日—15日（9:00–18:00）缴春季高考技能测试费。
      </div>
    </div>
  </section>

  <footer>
    时间节点与网址均取自 <a href="https://www.sdzk.cn/" target="_blank" rel="noopener">山东省教育招生考试院官网</a> 2026-10-20 正式文件。<br>
    Web Push 依 RFC 8291/8292 实现 ｜ 一键填写基于 Violentmonkey 开源用户脚本 ｜ 报名以官方系统实际提示为准。
  </footer>
</main>

<!-- 全屏提醒模式 -->
<div class="fsm" id="fsm">
  <div class="big" id="fsTitle">距 开 闸</div>
  <div class="count" id="fsCount">--:--:--</div>
  <div class="when" id="fsWhen">2026年10月24日 09:00 · 每天仅 9:00–18:00</div>
  <div class="fsbtns">
    <button class="fsb" onclick="closeFS()">退出</button>
    <a class="fsb" href="https://wsbm.sdzk.cn" target="_blank" rel="noopener">去报名 ↗</a>
  </div>
  <div class="tip">屏幕保持常亮 · 开闸时整屏变绿并提醒 ｜ 手机可将本页添加到主屏幕当提醒钟</div>
</div>

<div class="scrim" id="scrim" onclick="closeSheet()"></div>
<div class="sheet" id="sheet">
  <div class="grabber" id="grabber"><i></i></div>
  <div class="sheet-hd">实测截图证据</div>
  <div class="sheet-bd" id="sheetBd">
    <figure><img src="assets/evidence-wsbm.png" alt="wsbm.sdzk.cn 实测白屏"><figcaption><b>报名系统：完全白屏</b>浏览器标签一直显示「Loading https://wsbm.sdzk.cn/」，页面无任何内容渲染。</figcaption></figure>
    <figure><img src="assets/evidence-sdzk.png" alt="www.sdzk.cn 官网正常"><figcaption><b>同一体系官网：完全正常</b>www.sdzk.cn 完整渲染，报名通知就在首页 —— 佐证只有报名子系统未开闸。</figcaption></figure>
    <figure><img src="assets/notice.png" alt="官方报名通知"><figcaption><b>《关于做好山东省 2027 年普通高等学校招生考试报名工作的通知》</b>报名网址 https://wsbm.sdzk.cn ｜ 填报信息及缴纳报名费：2026年10月24日至30日（每天 9:00–18:00）</figcaption></figure>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
/* ==================================================================
   弹簧引擎（半隐式欧拉）—— Apple: ζ + response → k / c
   ================================================================== */
var RM = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
function Spring(value, o){
  o = o || {};
  this.value = value; this.target = value; this.velocity = 0;
  this.config(o.damping || 1, o.response || 0.4);
  this.eps = o.eps || 0.0005;
  springs.push(this);
}
Spring.prototype.config = function(zeta, response){ var w = 2*Math.PI/response; this.k = w*w; this.c = 2*zeta*w; };
Spring.prototype.to = function(t){ this.target = t; return this; };
Spring.prototype.jump = function(v){ this.value = v; this.target = v; this.velocity = 0; return this; };
Spring.prototype.step = function(dt){
  var a = -this.k*(this.value-this.target) - this.c*this.velocity;
  this.velocity += a*dt; this.value += this.velocity*dt;
  if (Math.abs(this.value-this.target) < this.eps && Math.abs(this.velocity) < this.eps){
    this.value = this.target; this.velocity = 0; return false;
  }
  return true;
};
var springs = [], lastT = 0, rafId = null;
function loop(now){
  var dt = lastT ? Math.min((now-lastT)/1000, 1/30) : 1/60;
  lastT = now;
  for (var i=0;i<springs.length;i++) springs[i].step(dt);
  draw();
  var busy = false;
  for (var j=0;j<springs.length;j++) if (springs[j].value!==springs[j].target||springs[j].velocity!==0){ busy=true; break; }
  rafId = busy ? requestAnimationFrame(loop) : null;
  if (!busy) lastT = 0;
}
function kick(){ if (rafId === null) rafId = requestAnimationFrame(loop); }

/* ---------- DOM ---------- */
var $ = function(id){ return document.getElementById(id); };
var sheet=$('sheet'), scrim=$('scrim'), thumb=$('thumb'), progBar=$('progBar'),
    ptr=$('ptr'), ptrIn=$('ptrIn'), ptrIcon=$('ptrIcon'), toast=$('toast'),
    knob=$('knob'), fsm=$('fsm');

/* ---------- springs ---------- */
var sheetY=new Spring(1100,{damping:.8,response:.32}), scrimO=new Spring(0,{damping:1,response:.3});
var ptrY=new Spring(0,{damping:1,response:.42}), ptrO=new Spring(0,{damping:1,response:.35}), ptrRot=new Spring(0,{damping:1,response:.35});
var toY=new Spring(20,{damping:.8,response:.32}), toO=new Spring(0,{damping:1,response:.3});
var progW=new Spring(0,{damping:1,response:.45}), knobX=new Spring(0,{damping:1,response:.35});
var thumbX=new Spring(0,{damping:1,response:.35});
var riseItems = [];

/* ==================================================================
   里程表：逐位弹簧滚动
   ================================================================== */
var odoCols = [];
(function buildOdo(){
  var cd = $('cd');
  var groups = [['天',2],['时',2],['分',2],['秒',2]];
  groups.forEach(function(g, gi){
    var grp = document.createElement('div'); grp.className = 'grp';
    var digits = document.createElement('div'); digits.className = 'digits';
    for (var i=0;i<g[1];i++){
      var odo = document.createElement('span'); odo.className='odo';
      var col = document.createElement('span'); col.className='col';
      for (var n=0;n<10;n++){ var it=document.createElement('i'); it.textContent=n; col.appendChild(it); }
      odo.appendChild(col); digits.appendChild(odo);
      odoCols.push({ spring: new Spring(0,{damping:.85,response:.4}), el: col, cur: 0 });
    }
    grp.appendChild(digits);
    var l = document.createElement('div'); l.className='l'; l.textContent=g[0]; grp.appendChild(l);
    cd.appendChild(grp);
    if (gi < 3){ var sep=document.createElement('div'); sep.className='sep'; sep.textContent=':'; cd.appendChild(sep); }
  });
})();
function setOdo(vals){
  var idx = 0;
  for (var g=0; g<vals.length; g++){
    var s = vals[g];
    for (var k=0; k<s.length; k++){
      var o = odoCols[idx++];
      var d = +s[k];
      if (o.cur !== d){
        o.cur = d;
        if (RM){ o.spring.jump(-d); } else { o.spring.to(-d); kick(); }
      }
    }
  }
}

/* ---------- 统一 draw ---------- */
function draw(){
  sheet.style.transform = 'translateY(' + sheetY.value + 'px)';
  scrim.style.opacity = scrimO.value;
  thumb.style.transform = 'translateX(' + thumbX.value + 'px)';
  progBar.style.width = progW.value + '%';
  var py = Math.max(0, ptrY.value);
  ptr.style.height = py + 'px';
  ptrIn.style.transform = 'translateY(' + (py-26) + 'px) scale(' + ptrO.value + ')';
  ptrIn.style.opacity = ptrO.value;
  ptrIcon.style.transform = 'rotate(' + ptrRot.value + 'deg)';
  toast.style.transform = 'translate(-50%,' + toY.value + 'px)';
  toast.style.opacity = toO.value;
  knob.style.transform = 'translateX(' + knobX.value + 'px)';
  for (var i=0;i<odoCols.length;i++) odoCols[i].el.style.transform = 'translateY(' + odoCols[i].spring.value + 'em)';
  for (var k=0;k<riseItems.length;k++){
    var s = riseItems[k]._spr; if (!s) continue;
    var v = s.value;
    riseItems[k].style.opacity = Math.min(1, Math.max(0, v));
    riseItems[k].style.transform = 'translateY(' + ((1-v)*14) + 'px) scale(' + (0.985+v*0.015) + ')';
  }
}

/* ---------- 入场 ---------- */
function collectRise(root){ riseItems = Array.prototype.slice.call((root||document).querySelectorAll('.rise')); }
function riseIn(root){
  collectRise(root);
  riseItems.forEach(function(el, i){
    if (RM){ el.style.opacity=1; el.style.transform='none'; return; }
    var s = el._spr; if (!s) s = el._spr = new Spring(0,{damping:1,response:.45});
    s.jump(0);
    setTimeout(function(){ s.to(1); kick(); }, i*55);
  });
}

/* ---------- 主题 ---------- */
(function(){
  var t = localStorage.getItem('sdzk-theme');
  if (!t) t = (matchMedia && matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
  document.documentElement.setAttribute('data-theme', t);
  syncKnob(t);
})();
function syncKnob(theme){
  var on = theme === 'dark';
  $('tgl').classList.toggle('on', on);
  document.querySelector('.i-m').style.display = on ? 'none':'block';
  document.querySelector('.i-s').style.display = on ? 'block':'none';
  knobX.jump(on ? 20 : 0);
}
function toggleTheme(){
  var n = document.documentElement.getAttribute('data-theme')==='dark' ? 'light':'dark';
  document.documentElement.setAttribute('data-theme', n);
  localStorage.setItem('sdzk-theme', n);
  knobX.to(n==='dark'?20:0); kick(); haptic();
}
function haptic(){ if (navigator.vibrate){ try{ navigator.vibrate(8); }catch(e){} } }

/* ---------- 时间节点 ---------- */
var T_OPEN=new Date('2026-10-24T09:00:00+08:00').getTime();
var T_CLOSE=new Date('2026-10-30T18:00:00+08:00').getTime();
var T_D0=new Date('2026-10-24T00:00:00+08:00').getTime();
var T_D1=new Date('2026-10-31T00:00:00+08:00').getTime();
var T_A1=new Date('2026-10-31T00:00:00+08:00').getTime();
var T_A2=new Date('2026-11-12T23:59:59+08:00').getTime();
var T_F1=new Date('2026-11-13T00:00:00+08:00').getTime();
var T_F2=new Date('2026-11-15T23:59:59+08:00').getTime();
function pad(n){ return String(n).padStart(2,'0'); }
function fmtDur(ms){
  var s=Math.floor(ms/1000), d=Math.floor(s/86400); s%=86400;
  var h=Math.floor(s/3600); s%=3600; var m=Math.floor(s/60);
  if (d>0) return d+' 天 '+h+' 小时';
  if (h>0) return h+' 小时 '+m+' 分';
  if (m>0) return m+' 分 '+(s%60)+' 秒';
  return s+' 秒';
}

/* ---------- 全屏提醒 ---------- */
var fsWake = null;
function openFS(){
  fsm.classList.add('on');
  haptic();
  if ('wakeLock' in navigator){
    navigator.wakeLock.request('screen').then(function(w){ fsWake=w; }).catch(function(){});
  }
  tick();
}
function closeFS(){
  fsm.classList.remove('on','breathing','opened');
  if (fsWake){ try{ fsWake.release(); }catch(e){} fsWake = null; }
}
document.addEventListener('visibilitychange', function(){
  if (!document.hidden && fsm.classList.contains('on') && 'wakeLock' in navigator && !fsWake){
    navigator.wakeLock.request('screen').then(function(w){ fsWake=w; }).catch(function(){});
  }
});
var fsOpened = false;
function fsTick(now){
  if (!fsm.classList.contains('on')) return;
  var d = T_OPEN - now;
  var E = $('fsCount');
  if (d > 0){
    var s = Math.floor(d/1000);
    E.innerHTML = pad(Math.floor(s/86400)) + ':' + pad(Math.floor(s%86400/3600)) + ':' + pad(Math.floor(s%3600/60)) + ':' + pad(s%60) + '<small>天:时:分:秒</small>';
    $('fsTitle').textContent = '距 开 闸';
    if (!fsm.classList.contains('breathing') && d < 3*3600e3) fsm.classList.add('breathing');
  } else {
    E.innerHTML = '已 开 闸';
    $('fsTitle').textContent = '现在就报名';
    fsm.classList.remove('breathing'); fsm.classList.add('opened');
    if (!fsOpened){ fsOpened = true; haptic(); if (navigator.vibrate) navigator.vibrate([300,100,300,100,300]);
      try { new Notification('山东高考报名已开闸', { body:'点这里去报名 wsbm.sdzk.cn' }); } catch(e){} }
  }
}

/* ---------- 主 tick ---------- */
var notifyOn = false, notified = false;
function tick(){
  var now = Date.now(), d = T_OPEN - now, vals;
  if (d > 0){
    var s = Math.floor(d/1000);
    vals = [String(Math.floor(s/86400)), pad(Math.floor(s%86400/3600)), pad(Math.floor(s%3600/60)), pad(s%60)];
  } else vals = ['0','00','00','00'];
  setOdo(vals);
  fsTick(now);
  mark('tl1', now>=T_OPEN && now<=T_CLOSE);
  mark('tl2', now>=T_A1 && now<=T_A2);
  mark('tl3', now>=T_F1 && now<=T_F2);
  mark('tl4', now>T_F2);
  markPast('tl1', now>T_CLOSE); markPast('tl2', now>T_A2); markPast('tl3', now>T_F2);

  var w = windowInfo(now);
  if (now < T_OPEN){
    $('tagText').textContent = '报名通道未开放';
    $('heroMeta').innerHTML = '<span class="live off"></span>距 <b>10月24日 09:00</b> 开闸 ｜ 每天仅 <b>9:00–18:00</b>';
  } else if (now <= T_CLOSE){
    $('tagText').textContent = '开放中，去报名';
    $('heroMeta').innerHTML = '<span class="live on"></span>' + (w.on?'现在就在开放时段内':'当前不在时段内') + ' ｜ ' + w.txt;
  } else if (now <= T_A2){
    $('tagText').textContent = '审核中';
    $('heroMeta').innerHTML = '填报已结束 · 资格审核 <b>10月31日—11月12日</b>';
  } else if (now <= T_F2){
    $('tagText').textContent = '缴费阶段';
    $('heroMeta').innerHTML = '缴考试费 <b>11月13日—15日，每天 9:00–18:00</b>';
  } else {
    $('tagText').textContent = '本期已结束';
    $('heroMeta').innerHTML = '春考知识 / 夏考统考费 <b>2027 年 4 月</b>缴纳';
  }
  var ws = $('winState');
  if (ws){
    ws.textContent = w.st;
    $('winDetail').textContent = w.txt;
    ws.style.color = w.on ? 'var(--green)' : 'var(--label)';
  }
  if (notifyOn && !notified && now >= T_OPEN && now <= T_CLOSE){
    notified = true;
    try { new Notification('山东高考报名已开闸', { body:'填报通道已开放，立即报名 wsbm.sdzk.cn' }); } catch(e){}
    say('开闸了！立即报名'); haptic();
  }
}
function mark(id,on){ var e=$(id); if (e) e.classList.toggle('now',!!on); }
function markPast(id,on){ var e=$(id); if (e) e.classList.toggle('past',!!on); }
function windowInfo(now){
  var dt = new Date(now);
  var dayStart = new Date(dt.getFullYear(), dt.getMonth(), dt.getDate()).getTime();
  if (now < T_D0) return { on:false, st:'未开始', txt:'距离开始还有 ' + fmtDur(T_D0-now) };
  if (now >= T_D1) return { on:false, st:'已结束', txt:'填报期已于 10 月 30 日 18:00 结束' };
  var h = dt.getHours() + dt.getMinutes()/60 + dt.getSeconds()/3600;
  if (h < 9)  return { on:false, st:'今日未开放', txt:'今日 09:00 开放 · 还剩 ' + fmtDur(dayStart + 9*3600e3 - now) };
  if (h < 18) return { on:true,  st:'开放中',   txt:'今日 18:00 截止 · 还剩 ' + fmtDur(dayStart + 18*3600e3 - now) };
  return { on:false, st:'今日已结束', txt:'明日 09:00 再来' };
}
tick(); setInterval(tick, 1000);

/* ---------- 分段 ---------- */
function segLayout(){ var seg=$('seg'); return (seg.clientWidth-4)/seg.querySelectorAll('button').length; }
function setView(name, btn){
  var seg=$('seg'), btns=seg.querySelectorAll('button'), idx=0;
  btns.forEach(function(b,i){ b.classList.toggle('on', b===btn); if (b===btn) idx=i; });
  var w = segLayout(); thumb.style.width = w+'px';
  if (RM) thumbX.jump(idx*w); else { thumbX.to(idx*w); kick(); }
  ['status','info','links','prep'].forEach(function(v){
    var el = $('v-'+v); el.classList.remove('on');
    if (v===name){ void el.offsetWidth; el.classList.add('on'); riseIn(el); }
  });
  haptic();
}
window.addEventListener('resize', function(){
  var seg=$('seg'), btns=seg.querySelectorAll('button');
  var idx = Array.prototype.indexOf.call(btns, seg.querySelector('button.on'));
  var w = segLayout(); thumb.style.width = w+'px'; thumbX.jump(idx*w);
});

/* ---------- Toast ---------- */
var toastTimer=null;
function say(m){
  toast.textContent=m; toY.jump(20); toO.jump(0); toY.to(0); toO.to(1); kick();
  clearTimeout(toastTimer); toastTimer=setTimeout(function(){ toY.to(20); toO.to(0); kick(); },2400);
}

/* ---------- 探测 + 历史 ---------- */
var HKEY='sdzk-probe-hist', hist=[];
try{ hist=JSON.parse(localStorage.getItem(HKEY)||'[]'); }catch(e){}
function renderHist(){
  var el=$('histList'); if (!el) return;
  if (!hist.length){ el.innerHTML='<div class="row"><div class="sub">暂无记录。点上方「立即探测」或在页面顶部下拉刷新。</div></div>'; return; }
  el.innerHTML = hist.map(function(r){
    var t=new Date(r.t);
    var tag={s:'有响应',d:'无响应'}[r.k]||r.k;
    var cls={s:'ok',d:'bad'}[r.k]||'';
    return '<div class="row"><div class="lb">'+tag+'</div><div class="vl mono '+cls+'">'
      +pad(t.getMonth()+1)+'-'+pad(t.getDate())+' '+pad(t.getHours())+':'+pad(t.getMinutes())+':'+pad(t.getSeconds())
      +'</div></div>';
  }).join('');
}
function addHist(kind){ hist.unshift({t:Date.now(),k:kind}); hist=hist.slice(0,6);
  try{ localStorage.setItem(HKEY,JSON.stringify(hist)); }catch(e){} renderHist(); }
renderHist();

var probing=false;
function probe(){
  if (probing) return;
  probing=true;
  var btn=$('probeBtn'), tx=$('probeTx');
  btn.classList.add('spin'); tx.textContent='探测中…';
  setStat('w','正在直连 wsbm.sdzk.cn');
  var ctrl=new AbortController();
  var timer=setTimeout(function(){ ctrl.abort(); },8000);
  fetch('https://wsbm.sdzk.cn/',{mode:'no-cors',cache:'no-store',signal:ctrl.signal})
    .then(function(){ clearTimeout(timer); setStat('s','服务器有响应 —— 系统已开通'); addHist('s');
      say('系统已可访问，快去报名'); if (navigator.vibrate) navigator.vibrate([10,40,10]); })
    .catch(function(e){
      clearTimeout(timer);
      var aborted = e && e.name==='AbortError';
      if (aborted){ setStat('d','请求发出后 8 秒无任何回包'); addHist('d');
        say(Date.now()<T_OPEN ? '尚未到开放时间（10月24日 09:00）' : '可能拥堵，避开 9–11 点高峰'); }
      else { setStat('d','无法建立连接'); addHist('d'); say('连接失败，请检查网络'); }
      if (navigator.vibrate) navigator.vibrate(12);
    })
    .then(function(){ btn.classList.remove('spin'); tx.textContent='立即探测'; probing=false;
      ptrY.to(0); ptrO.to(0); ptrRot.to(0); kick(); });
}
function setStat(kind,text){
  $('pstat').innerHTML='<span class="pill '+kind+'">'+({s:'已开通',d:'未响应',w:'连接中'}[kind]||'待探测')+'</span><span>'+text+'</span>';
}

/* ---------- 下拉刷新 ---------- */
var ptrStart=null;
function rubberband(o,dim,c){ c=c||0.55; return (o*dim*c)/(dim+c*Math.abs(o)); }
document.addEventListener('pointerdown',function(e){
  if (sheetOpen || fsm.classList.contains('on')) return;
  if (window.scrollY>0) return;
  if (e.target.closest && e.target.closest('.sheet,.tgl,.seg,a,button,input,select,textarea')) return;
  ptrStart={y:e.clientY,t:performance.now(),active:false};
},{passive:true});
document.addEventListener('pointermove',function(e){
  if (!ptrStart) return;
  var dy=e.clientY-ptrStart.y;
  if (dy<=0){ if (ptrY.value>0){ ptrY.to(0); ptrO.to(0); kick(); } return; }
  if (window.scrollY>0){ ptrStart=null; return; }
  ptrStart.active=true;
  ptrY.jump(rubberband(dy,240)); ptrO.jump(Math.min(1,ptrY.value/46)); ptrRot.jump(ptrY.value*3.2);
  kick();
  if (ptrY.value>30 && e.cancelable) e.preventDefault();
},{passive:false});
document.addEventListener('pointerup',function(){
  if (!ptrStart) return;
  var st=ptrStart; ptrStart=null;
  if (!st.active) return;
  if (ptrY.value>48){ ptrY.to(52); ptrO.to(1); kick(); ptrRot.jump(0); ptrRot.to(1080); kick(); setTimeout(probe,120); }
  else { ptrY.to(0); ptrO.to(0); ptrRot.to(0); kick(); }
},{passive:true});
document.addEventListener('pointercancel',function(){ ptrStart=null; ptrY.to(0); ptrO.to(0); ptrRot.to(0); kick(); });

/* ---------- Sheet ---------- */
var sheetOpen=false, sheetH=0, drag=null;
var sheetBd=$('sheetBd');
function openSheet(){
  if (sheetOpen) return; sheetOpen=true; sheetH=sheet.offsetHeight;
  sheet.style.visibility='visible'; scrim.style.pointerEvents='auto';
  if (RM){ sheetY.jump(0); scrimO.jump(1); draw(); }
  else { sheetY.jump(sheetH); sheetY.to(0); scrimO.jump(0); scrimO.to(1); kick(); }
  haptic();
}
function closeSheet(){
  if (!sheetOpen) return; sheetOpen=false; scrim.style.pointerEvents='none';
  if (RM){ sheetY.jump(sheetH); scrimO.jump(0); draw(); return; }
  sheetY.to(sheetH); scrimO.to(0); kick();
}
function onDown(e){
  if (!sheetOpen) return;
  if (e.currentTarget===sheetBd && sheetBd.scrollTop>0) return;
  try{ e.currentTarget.setPointerCapture(e.pointerId); }catch(err){}
  drag={y:e.clientY,base:sheetY.value,hist:[{y:e.clientY,t:performance.now()}],id:e.pointerId};
  sheetY.jump(sheetY.value);
}
function onMove(e){
  if (!drag||e.pointerId!==drag.id) return;
  var y=drag.base+(e.clientY-drag.y);
  if (y<0) y=-rubberband(-y,300);
  sheetY.jump(y); scrimO.jump(Math.max(0,Math.min(1,1-y/sheetH))); kick();
  var h=drag.hist; h.push({y:e.clientY,t:performance.now()}); if (h.length>5) h.shift();
}
function onUp(e){
  if (!drag||e.pointerId!==drag.id) return;
  var h=drag.hist, v=0;
  if (h.length>=2){ var a=h[0],b=h[h.length-1],dt=(b.t-a.t)/1000; if (dt>0) v=(b.y-a.y)/dt; }
  var cur=sheetY.value; drag=null;
  var projected=cur+(v/1000)*0.998/(1-0.998);
  var shouldClose = v>700 || projected>sheetH*0.35;
  if (RM){ if (shouldClose) closeSheet(); else { sheetY.jump(0); scrimO.jump(1); draw(); } return; }
  sheetY.velocity=v;
  if (shouldClose){ sheetOpen=false; scrim.style.pointerEvents='none'; sheetY.to(sheetH); scrimO.to(0); }
  else { sheetY.to(0); scrimO.to(1); }
  kick();
}
['grabber','sheetBd'].forEach(function(id){
  var el=$(id);
  el.addEventListener('pointerdown',onDown);
  el.addEventListener('pointermove',onMove);
  el.addEventListener('pointerup',onUp);
  el.addEventListener('pointercancel',onUp);
});
scrim.addEventListener('click',closeSheet);

/* ==================================================================
   报名信息卡（一键填写数据源）—— 只存本机
   ================================================================== */
var IKEY='sdzk-info';
var FIELDS=['name','idcard','phone','nation','politics','examType','category','school','studentNo','qq','email','address'];
var photoData='', photoName='';
function saveInfo(){
  var d={}; FIELDS.forEach(function(k){ var el=$('f-'+k); d[k]= el ? el.value.trim() : ''; });
  if (photoData){ d.photo=photoData; d.photoName=photoName; }
  try{ localStorage.setItem(IKEY,JSON.stringify(d)); }
  catch(e){ say('保存失败：照片太大，换张小的试试'); }
  return d;
}
function loadInfo(){
  var d={}; try{ d=JSON.parse(localStorage.getItem(IKEY)||'{}'); }catch(e){}
  FIELDS.forEach(function(k){ var el=$('f-'+k); if (el && d[k]) el.value=d[k]; });
  if (d.photo){ photoData=d.photo; photoName=d.photoName||'photo.jpg';
    var p=$('photoPrev'); p.src=photoData; p.classList.add('show');
    $('photoHint').textContent='已存好（本机）'; }
  idcCheck();
}
$('f-photo').addEventListener('change', function(){
  var f=this.files && this.files[0]; if (!f) return;
  var img=new Image();
  img.onload=function(){
    var max=800, w=img.width, h=img.height;
    var sc=Math.min(1, max/Math.max(w,h));
    var c=document.createElement('canvas'); c.width=Math.round(w*sc); c.height=Math.round(h*sc);
    c.getContext('2d').drawImage(img,0,0,c.width,c.height);
    photoData=c.toDataURL('image/jpeg',.85);
    photoName=(f.name||'photo.jpg').replace(/\.[^.]+$/,'')+'.jpg';
    var p=$('photoPrev'); p.src=photoData; p.classList.add('show');
    $('photoHint').textContent='已压缩保存（本机）：'+c.width+'×'+c.height;
    saveInfo(); haptic();
  };
  img.onerror=function(){ say('这张图读不了，换一张试试'); };
  img.src=URL.createObjectURL(f);
});
function idcCheck(){
  var id=$('f-idcard').value.trim();
  var hint=$('idcHint');
  hint.style.color='';
  if (!id){ hint.textContent='填写后自动推导出生日期与性别'; hint.className='hint'; return; }
  if (!/^\d{17}[\dXx]$/.test(id)){ hint.textContent='格式不对：应为 18 位（最后一位可为 X）'; hint.className='hint'; hint.style.color='var(--red)'; return; }
  var ok=true, W=[7,9,10,5,8,4,2,1,6,3,7,9,10,5,8,4,2], M='10X98765432';
  var sum=0; for (var i=0;i<17;i++) sum+=+id[i]*W[i];
  if (M[sum%11]!==id[17].toUpperCase()) ok=false;
  var g=(+id[16])%2===1?'男':'女';
  hint.textContent=(ok?'✓ 校验通过 ｜ ':'⚠ 校验位不符，请核对 ｜ ')+'出生 '+id.slice(6,10)+'-'+id.slice(10,12)+'-'+id.slice(12,14)+' ｜ '+g;
  hint.className='hint';
  hint.style.color= ok ? 'var(--green)' : 'var(--orange)';
}
$('f-idcard').addEventListener('blur', idcCheck);
FIELDS.forEach(function(k){
  var el=$('f-'+k); if (el) el.addEventListener('change', saveInfo);
});
function copyInfo(){
  var d=saveInfo();
  if (!d.name && !d.idcard){ say('先把姓名和身份证填上'); return; }
  var j=JSON.stringify(d);
  var done=function(){ say('报名数据已复制 → 去报名页点悬浮球「导入面板数据」'); haptic(); };
  if (navigator.clipboard&&navigator.clipboard.writeText&&window.isSecureContext) navigator.clipboard.writeText(j).then(done,fb); else fb();
  function fb(){
    var i=document.createElement('textarea'); i.value=j; document.body.appendChild(i); i.select();
    try{ document.execCommand('copy'); done(); }catch(e){ say('复制失败，请长按手动复制'); }
    document.body.removeChild(i);
  }
}
loadInfo();

/* ==================================================================
   Web Push 订阅
   ================================================================== */
function urlB64ToU8(b64){
  var pad='='.repeat((4-b64.length%4)%4);
  var b=(b64+pad).replace(/-/g,'+').replace(/_/g,'/');
  var raw=atob(b); var out=new Uint8Array(raw.length);
  for (var i=0;i<raw.length;i++) out[i]=raw.charCodeAt(i);
  return out;
}
var pushSubscribed = localStorage.getItem('sdzk-push')==='1';
function updNotifyBtn(){ $('notifyBtn').classList.toggle('on', pushSubscribed); }
updNotifyBtn();
async function subscribePush(){
  try{
    if (!('serviceWorker' in navigator) || !('PushManager' in window) || !('Notification' in window)){
      say('此浏览器不支持推送，用全屏提醒吧'); return;
    }
    var iOS=/iphone|ipad|ipod/i.test(navigator.userAgent);
    var standalone = matchMedia('(display-mode: standalone)').matches || navigator.standalone===true;
    if (iOS && !standalone){ say('iPhone：请先「添加到主屏幕」，从图标打开后再点'); return; }
    var perm = await Notification.requestPermission();
    if (perm!=='granted'){ say('通知权限被拒绝，可在浏览器设置里改'); return; }
    var reg = await navigator.serviceWorker.register('./sw.js');
    await navigator.serviceWorker.ready;
    var key = await (await fetch('./api/vapid')).json();
    var sub = await reg.pushManager.subscribe({ userVisibleOnly:true, applicationServerKey: urlB64ToU8(key.publicKey) });
    var r = await fetch('./api/subscribe',{ method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(sub) });
    if (!r.ok) throw new Error('服务器拒绝');
    pushSubscribed=true; localStorage.setItem('sdzk-push','1'); updNotifyBtn();
    say('开闸提醒已开启：09:00 锁屏也会收到推送');
    haptic();
  }catch(e){ say('订阅失败：'+(e.message||'未知').slice(0,50)); }
}

/* ---------- 复制 / 导航 ---------- */
function copyUrl(){
  var u='https://wsbm.sdzk.cn';
  var done=function(){ say('已复制 '+u); haptic(); };
  if (navigator.clipboard&&navigator.clipboard.writeText&&window.isSecureContext) navigator.clipboard.writeText(u).then(done,fb); else fb();
  function fb(){ var i=document.createElement('input'); i.value=u; document.body.appendChild(i); i.select();
    try{ document.execCommand('copy'); done(); }catch(e){ say('请手动复制：'+u); } document.body.removeChild(i); }
}
var nav=$('nav');
window.addEventListener('scroll',function(){ nav.classList.toggle('scrolled',window.scrollY>8); },{passive:true});

/* ---------- 启动 ---------- */
function boot(){
  var w=segLayout(); thumb.style.width=w+'px'; thumbX.jump(0);
  riseIn($('v-status'));
  draw();
}
if (document.readyState==='complete') boot();
else { window.addEventListener('load',boot); setTimeout(function(){ if (!riseItems.length) boot(); },1500); }
</script>
</body>
</html>
